{
  "permissions": {
    "allow": [
      "Bash(./venv/Scripts/python.exe .claude/tools/read_db.py *)",
      "Bash(venv/Scripts/python.exe .claude/tools/read_db.py *)",
      "PowerShell(.\\venv\\Scripts\\python.exe .claude\\tools\\read_db.py *)",
      "PowerShell(.\\venv\\Scripts\\python.exe .claude/tools/read_db.py *)"
    ],
    "deny": [
      "Bash(sqlcmd*)",
      "PowerShell(sqlcmd*)",
      "PowerShell(Invoke-Sqlcmd*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Bash(cat *.env*)",
      "PowerShell(Get-Content *.env*)",
      "PowerShell(gc *.env*)",
      "PowerShell(cat *.env*)",
      "PowerShell(type *.env*)",
      "Read(./.claude/*.local.json)",
      "Edit(./.claude/*.local.json)",
      "Bash(cat *.local.json*)",
      "PowerShell(Get-Content *.local.json*)",
      "PowerShell(gc *.local.json*)",
      "PowerShell(cat *.local.json*)",
      "PowerShell(type *.local.json*)",

      "Bash(*python* *src/main.py*)",
      "Bash(*python* *src\\main.py*)",
      "PowerShell(*python* *src/main.py*)",
      "PowerShell(*python* *src\\main.py*)",
      "Bash(*python* *scripts/*)",
      "Bash(*python* *scripts\\*)",
      "PowerShell(*python* *scripts/*)",
      "PowerShell(*python* *scripts\\*)",

      "Bash(git commit*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git branch -D*)",
      "PowerShell(git commit*)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git clean -f*)",
      "PowerShell(git branch -D*)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(git merge*)",
      "Bash(git rebase*)",
      "Bash(gh pr create*)",
      "Bash(gh pr merge*)",
      "PowerShell(git push*)",
      "PowerShell(git merge*)",
      "PowerShell(git rebase*)",
      "PowerShell(gh pr create*)",
      "PowerShell(gh pr merge*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/block_get_content_roundtrip.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
